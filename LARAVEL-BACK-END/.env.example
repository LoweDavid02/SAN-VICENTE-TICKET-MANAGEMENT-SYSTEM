APP_NAME="Barangay Connect"
APP_ENV=production
APP_KEY=                          # Set this in Render dashboard (auto-generated)
APP_DEBUG=false
APP_URL=https://your-api.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=error

# PostgreSQL — Render fills these automatically from the database service
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Your React frontend URL — set in Render dashboard
FRONTEND_URL=https://your-frontend.onrender.com
