# Production Environment Variables Example
# Copy this file to .env.production and fill in your actual values
# These values should also be set in your Render environment variables

# API URL - Should point to your backend service
# Example: https://your-backend.onrender.com/api/v1
VITE_API_URL=/api/v1

# Google reCAPTCHA v2 Site Key (Public - safe to expose)
# Get from: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your-site-key-here

# WebSocket URL (if using real-time features)
# Example: wss://your-backend.onrender.com/ws
VITE_WS_URL=

# Google Maps API Key (optional, not used for map)
VITE_GOOGLE_MAPS_KEY=

# VAPID Public Key for Push Notifications (optional)
VITE_VAPID_PUBLIC_KEY=
