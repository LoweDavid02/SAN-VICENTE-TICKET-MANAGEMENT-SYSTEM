    {
      "name": "Guest",
      "item": [
        {
          "name": "Submit Ticket (Civic UI)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has tracking_id\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('tracking_id');",
                  "    pm.collectionVariables.set('tracking_id', jsonData.tracking_id);",
                  "    pm.collectionVariables.set('tracking_code', jsonData.tracking_id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guest_name\": \"Juan Dela Cruz\",\n  \"guest_email\": \"juan@example.com\",\n  \"guest_phone\": \"09171234567\",\n  \"guest_address\": \"123 Main Street, San Vicente\",\n  \"title\": \"Streetlight not working on Main St\",\n  \"description\": \"The streetlight at the corner of Main St and Rizal Ave has been out for 3 days.\",\n  \"category\": \"streetlight\",\n  \"location\": \"Main Street, San Vicente\",\n  \"latitude\": 14.9500,\n  \"longitude\": 120.7000,\n  \"severity\": \"medium\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/tickets",
              "host": ["{{base_url}}"],
              "path": ["tickets"]
            },
            "description": "Submit a guest ticket via the Civic UI route (POST /tickets). Note: captcha_token is required by the server in production but is omitted here for testing. If reCAPTCHA is enforced, the request will return 422. Disable reCAPTCHA validation in local .env (RECAPTCHA_SECRET=test) to bypass."
          },
          "response": []
        },
        {
          "name": "Track Ticket (GET — Legacy)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has ticket data\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success');",
                  "    pm.expect(jsonData).to.have.property('ticket');",
                  "    pm.expect(jsonData.ticket).to.have.property('tracking_id');",
                  "    pm.expect(jsonData.ticket).to.have.property('status');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/guest/tickets/{{tracking_id}}",
              "host": ["{{base_url}}"],
              "path": ["guest", "tickets", "{{tracking_id}}"]
            },
            "description": "Legacy GET route: GET /guest/tickets/{trackingCode}. Still works alongside the newer POST /tickets/track route."
          },
          "response": []
        },
        {
          "name": "Track Ticket (POST — Civic UI)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has success and ticket\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData).to.have.property('ticket');",
                  "    pm.expect(jsonData.ticket).to.have.property('tracking_id');",
                  "    pm.expect(jsonData.ticket).to.have.property('status');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference_code\": \"{{tracking_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/tickets/track",
              "host": ["{{base_url}}"],
              "path": ["tickets", "track"]
            },
            "description": "Civic UI route for tracking a ticket by reference code. POST /tickets/track with body { reference_code }."
          },
          "response": []
        },
        {
          "name": "Confirm Resolution",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has success\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolved\": true,\n  \"note\": \"Issue has been resolved\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/tickets/{{tracking_id}}/confirm",
              "host": ["{{base_url}}"],
              "path": ["tickets", "{{tracking_id}}", "confirm"]
            },
            "description": "Resident confirms whether the ticket issue has been resolved. PATCH /tickets/{ref}/confirm. Ticket must be in 'Completed' status. resolved=true closes the ticket as 'Verified & Closed'; resolved=false adds a note that the issue is still unresolved."
          },
          "response": []
        }
      ]
    },
